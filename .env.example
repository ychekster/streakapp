# Telegram Bot Token, полученный у @BotFather (нужен боту и API — для проверки initData)
BOT_TOKEN=your_bot_token_here

# Публичный HTTPS-адрес фронтенда Mini App (обязателен: бот открывает приложение)
TMA_URL=https://your-mini-app.example.com

# Строка подключения к БД для API-сервера и alembic (async-драйвер обязателен).
# По умолчанию — локальный SQLite-файл.
DATABASE_URL=sqlite+aiosqlite:///./streakbot.db
# Для перехода на PostgreSQL (см. docs/SCALING.md):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/streakbot

# Пул соединений с PostgreSQL (для SQLite не используется)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Хост и порт API-сервера. По умолчанию — только локальный интерфейс (снаружи API
# доступен через nginx или туннель); 0.0.0.0 — например, внутри Docker-контейнера.
TMA_HOST=127.0.0.1
TMA_PORT=8000

# Разрешённые источники CORS через запятую ("*" — любой; авторизация — заголовком)
# TMA_ALLOWED_ORIGINS=https://your-mini-app.example.com

# Максимальный возраст подписи initData в секундах (0 — без проверки)
# TMA_AUTH_TTL_SECONDS=86400

# Лимит частоты запросов одного пользователя: запросов подряд и в секунду (0 — выкл.)
# TMA_RATE_LIMIT_BURST=60
# TMA_RATE_LIMIT_PER_SECOND=5

# Документация API (/docs, /redoc, /openapi.json) — только для разработки
# TMA_DOCS_ENABLED=false

# Логи API: уровень и файл с ротацией (пусто — только stderr)
# TMA_LOG_LEVEL=INFO
# TMA_LOG_FILE=logs/api.log

# Уровень логирования бота: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Файл для записи логов бота
LOG_FILE=logs/bot.log
