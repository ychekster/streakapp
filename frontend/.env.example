# Base URL of the API (backend), read when Vite builds the app.
# Local development (backend on TMA_PORT by default):
VITE_API_BASE_URL=http://localhost:8000
# Production (frontend/.env.production on the server): the API behind nginx on the same
# domain — a relative path, so the build does not depend on the domain:
# VITE_API_BASE_URL=/api
# Bot link of «Открыть в Telegram» on the landing page.
VITE_TELEGRAM_BOT_URL=https://t.me/onStreakBot
