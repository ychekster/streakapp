{
  "//": "The service worker (src/sw.ts) runs in a worker, not a page: its own libs.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "types": ["vite-plugin-pwa/client"]
  },
  "include": ["src/sw.ts"]
}
